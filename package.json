{
  "name": "flowfield-3d-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D streamsurface/streamline viewer for vector grids with real integration, picking and validation",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/three": "0.187.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
